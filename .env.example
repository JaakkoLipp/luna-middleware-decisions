# --- Upstream: OpenRouter (default) ---
OPENROUTER_API_KEY=

# --- Upstream: LiteLLM proxy (e.g. in front of Azure); use instead of the block above ---
# DMW_UPSTREAM_BASE_URL=http://litellm:4000/v1
# DMW_LUNA_MODEL=luna-decisions
# DMW_FORWARD_AUTH=true
# DMW_MAX_RETRIES=0

DMW_LUNA_MODEL=openai/gpt-6-luna
DMW_ALLOWED_MODELS=
# Luna: none | low | medium | high | xhigh (minimal is not supported)
DMW_REASONING_EFFORT=none

# --- Inbound auth: exactly one of these ---
DMW_API_KEYS=
# DMW_FORWARD_AUTH=true
# DMW_ALLOW_ANONYMOUS=true   # local development only
DMW_RATE_LIMIT_PER_MINUTE=0

# --- Decisions ---
DMW_SAMPLES=1
DMW_MAX_SAMPLES=8
DMW_SEED=0
DMW_TOPK_THRESHOLD=20
DMW_TOPK=5
DMW_MAX_QUESTIONS_PER_CALL=8
# DMW_CALIBRATION_PATH=calibration.json

# --- Limits and transport ---
DMW_MAX_QUESTIONS=64
DMW_MAX_STATE_CHARS=200000
DMW_REQUEST_TIMEOUT_S=30
DMW_TIMEOUT_S=20
DMW_MAX_RETRIES=2
DMW_MAX_CONCURRENCY=16
